# Copy this file to ~/.config/plinx/xcode-cloud.env and chmod it 600.
# Keep the .p8 file outside the repository and chmod it 600 as well.
PLINX_ASC_KEY_ID=YOUR_KEY_ID
PLINX_ASC_ISSUER_ID=YOUR_ISSUER_ID
PLINX_ASC_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8

# Optional: after the first successful discovery, pin monitoring to Plinx's
# Xcode Cloud product ID so other team products are not included.
PLINX_XCODE_CLOUD_PRODUCT_ID=
