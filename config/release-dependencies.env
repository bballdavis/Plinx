# Exact sibling-repository revisions and integration contract used by CI and
# release builds. This file is shell-readable so the build scripts, CI, and
# contract verifier share one machine-readable pairing definition.
STRIMR_COMMIT=ad0fe265bc6069c184fd7e47d68597d0f5036a15
STRIMR_BRANCH=dev-plinx
STRIMR_UPSTREAM_BASE=e0a8cbccbaf22b593defb00317da0bfaf06a1a07

# Each record is `<path relative to ../strimr>|<required literal source token>`.
# The verifier checks these narrow seams because Plinx intentionally compiles
# Strimr sources into the app module and depends on their internal APIs.
STRIMR_REQUIRED_SEAMS='Shared/Models/Plex/PlexMediaModels.swift|PlexFlexibleBool
Shared/Features/MediaDetail/MediaDetailViewModel.swift|static func preferredTitleLogo
Shared/Features/MediaDetail/MediaDetailViewModel.swift|var itemFilter
Shared/Features/MediaDetail/MediaDetailViewModel.swift|var hubFilter
Shared/Features/PlaylistDetail/PlaylistDetailViewModel.swift|var itemFilter
Shared/Features/HubDetail/HubDetailViewModel.swift|var itemFilter
Shared/Features/Library/LibraryBrowseViewModel.swift|var itemFilter
Shared/Features/Library/LibraryRecommendedViewModel.swift|var hubFilter
Shared/Features/Downloads/DownloadIntegrityValidator.swift|enum DownloadIntegrityValidator
Shared/Features/Downloads/DownloadManager.swift|DownloadPersistenceFailure
Shared/Models/AppSettings.swift|enum DownloadQuality
Shared/Library/Player/PlayerController.swift|func setMaximumVolume
Strimr-iOS/Features/Player/PlayerView.swift|playerController.setMaximumVolume(
Strimr-tvOS/Features/Player/PlayerTVView.swift|playerController.setMaximumVolume(
Strimr-iOS/Features/Player/PlayerView.swift|isPlaybackAuthorized
Strimr-iOS/Features/Player/PlayerView.swift|guard isPlaybackAuthorized(
Strimr-tvOS/Features/Player/PlayerTVView.swift|isPlaybackAuthorized
Strimr-tvOS/Features/Player/PlayerTVView.swift|guard isPlaybackAuthorized(
Strimr-iOS/Features/Player/PlayerWrapper.swift|showsBufferingOverlay: Bool = true
Strimr-iOS/Features/Player/PlayerView.swift|showsBufferingOverlay
Strimr-tvOS/Features/Player/PlayerTVWrapper.swift|showsBufferingOverlay: Bool = true
Strimr-tvOS/Features/Player/PlayerTVView.swift|showsBufferingOverlay
Strimr-tvOS/Features/Library/Detail/LibraryBrowseViewModel.swift|var itemFilter
Strimr-tvOS/Features/Library/Detail/LibraryCollectionsViewModel.swift|var itemFilter'

# Sources that must remain part of the generated Plinx app targets. One path
# per line, relative to PlinxApp/project.yml.
STRIMR_REQUIRED_PROJECT_SOURCES='../../strimr/Shared
../../strimr/Strimr-iOS/Features
../../strimr/Strimr-tvOS/Features'
