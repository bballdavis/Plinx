# Local-only
.vscode/
.venv/
__pycache__/

# Xcode / Swift
.DS_Store
*.xcuserstate
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.xcuserdata/
*.moved-aside
*.swp
*.orig
*.ipa
*.dSYM

# SwiftPM
.build/
.swiftpm/xcode/package.xcworkspace/
.swiftpm/configuration/
Packages/*/.swiftpm/

# Carthage
Carthage/Build/

# Local Environment Variables (Never commit)
test_creds.yaml
screenshot_capture.yaml
xcode-cloud.env
*.p8

# Build outputs
build/
website/build/
website/.docusaurus/
website/.generated/
website/node_modules/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Derived data (usually outside repo, but ignore just in case)
DerivedData/

# PlinxApp/Plinx.xcodeproj is a checked-in Xcode Cloud input. Machine-specific
# state inside it remains ignored by the global *.xcuserdata rules above.
